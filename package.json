{
	"name": "carousel-signage",
	"version": "1.0.0",
	"description": "Bitfocus Companion module for Carousel player routing, timed overrides, and CAP alerts",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"build": "node scripts/clean-build.mjs && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"check": "companion-module-check",
		"dev": "tsc -p tsconfig.build.json --watch",
		"format": "prettier -w src scripts companion docs .github README.md CHANGELOG.md package.json '*.{json,cjs,mjs,ts}'",
		"format:check": "prettier --check src scripts companion docs .github README.md CHANGELOG.md package.json '*.{json,cjs,mjs,ts}'",
		"lint": "eslint src scripts eslint.config.mjs vitest.config.ts",
		"test:package": "node scripts/smoke-package.mjs",
		"test:emergency-package": "node scripts/smoke-emergency.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"package": "run build && companion-module-build",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-carousel-signage.git"
	},
	"bugs": {
		"url": "https://github.com/bitfocus/companion-module-carousel-signage/issues"
	},
	"engines": {
		"node": "^26.5",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.0.0",
		"eslint": "^10.9.1",
		"prettier": "^3.8.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.69.0",
		"vitest": "^4.1.11"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.12.0",
	"author": "Eric Busby (https://github.com/ericbusby77)",
	"resolutions": {
		"minimatch": "^11.0.1"
	}
}
